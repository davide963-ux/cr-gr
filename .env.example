# Neon pooled connection string (server-side only!)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Random 32+ char string for signing session cookies
SESSION_SECRET=
# Protects /api/cron/payout (Vercel sends it as Bearer token)
CRON_SECRET=
# Solana / pump.fun token
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HASHRUSH_MINT=            # token mint address from pump.fun
TREASURY_SECRET_KEY=      # base58 secret key of the prize wallet (ONLY on the payout runner)
WEEKLY_PRIZE_POOL=1000000 # whole tokens distributed each Monday
PAYOUT_DRY_RUN=true       # set to false only when you are ready to send real tokens
