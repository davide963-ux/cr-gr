# Neon pooled connection string (server-side only!)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Random 32+ char string for signing session cookies
SESSION_SECRET=
# Used only by `npm run winners` to suggest prize amounts (whole tokens)
WEEKLY_PRIZE_POOL=1000000
# Public URL of the site (used in email links)
APP_URL=http://localhost:3000
# Email via Resend (https://resend.com). If RESEND_API_KEY is empty, links are printed to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM="HashRush <login@yourdomain.com>"
